APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_CONCURRENT_AGENTS=4

MODEL_PROVIDER=openai
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL_NAME=gpt-5.6
# ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL_NAME=claude-sonnet-4-5
MODEL_TEMPERATURE_ANALYTICAL=0.2
MODEL_TEMPERATURE_CREATIVE=0.5

# Potrzebne tylko gdy source_text jest pusty i agent ma wyszukiwać sam.
# TAVILY_API_KEY=your-tavily-key

# Lokalny Mongo uruchomiony np. przez Docker:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=canarias_cerca_editor

OUTPUT_DIR=./output
MAX_REVISIONS=5
MAX_SEARCH_RESULTS=8

# Photo Manager
# local = skanuje zwykły folder na dysku (najłatwiejszy start)
# drive = skanuje folder Google Drive przez Drive API
PHOTO_SOURCE=local
PHOTO_LOCAL_ROOT=./photo_inbox

# Dla PHOTO_SOURCE=drive:
# GOOGLE_DRIVE_ROOT_FOLDER_ID=folder_id_from_drive_url
# GOOGLE_SERVICE_ACCOUNT_FILE=C:/path/to/service-account.json
